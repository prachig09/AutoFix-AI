# Keep the build context tiny and keep secrets/dev files out of the image.
# NOTE: model.joblib must NOT be listed here - the Dockerfile copies it.

.git
.github
.gitignore
.venv
venv
env
__pycache__
**/__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
.idea
.vscode
.DS_Store

# Training/edge artifacts and tooling that the API does not need at runtime
train_model.py
edge_model.json
edge_prescreen.py
scripts
Dockerfile
.dockerignore
*.md

# Never ship credentials
.env
.env.*
*.json.key
service-account*.json
